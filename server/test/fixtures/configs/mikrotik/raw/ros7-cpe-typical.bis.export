/interface ethernet set [ find default-name=ether3 ] name=ether3 mtu=1500
/interface ethernet set [ find default-name=ether2 ] name=ether2
/interface vlan add name=vlan30-voip vlan-id=30 interface=bridge-lan
/interface list add name=LAN
/interface list add name=WAN
