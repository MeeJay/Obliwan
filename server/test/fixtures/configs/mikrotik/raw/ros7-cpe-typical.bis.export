/ip firewall nat add chain=srcnat action=masquerade out-interface-list=WAN comment="defconf: masquerade"
/ip firewall nat add chain=dstnat action=dst-nat protocol=tcp dst-port=443 in-interface-list=WAN to-addresses=10.20.30.20 to-ports=443 comment="web interne"
/ip firewall mangle add chain=prerouting action=mark-routing new-routing-mark=to-wan2 passthrough=yes src-address=10.30.30.0/24 comment="voip via wan2"
