/ip firewall filter add chain=input action=accept protocol=tcp dst-port=8291,22 src-address-list=mgmt comment="obliwan:mgmt-from-chr"
/ip firewall filter add chain=input action=drop connection-state=invalid comment="defconf: drop invalid"
/ip firewall filter add chain=input action=accept protocol=1 comment="defconf: accept ICMP"
/ip firewall filter add chain=input action=accept protocol=udp dst-port=53 \
    in-interface-list=LAN comment="dns depuis le LAN"
/ip firewall filter add chain=input action=accept protocol=tcp dst-port=53 in-interface-list=LAN comment="dns tcp depuis le LAN"
/ip firewall filter add chain=input action=drop in-interface-list=!LAN comment="defconf: drop all not coming from LAN"
/ip firewall filter add chain=forward action=accept connection-state=untracked,established,related comment="defconf: accept established,related, untracked"
/ip firewall filter add chain=forward action=drop connection-state=invalid comment="defconf: drop invalid"
/ip firewall filter add chain=forward action=drop connection-state=new connection-nat-state=!dstnat in-interface-list=WAN comment="defconf: drop all from WAN not DSTNATed"
/ip firewall filter add chain=forward action=accept src-address=10.30.30.0/24 out-interface-list=WAN comment="voip vers internet"
